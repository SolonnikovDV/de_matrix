DE_MATRIX_STORAGE_MODE=db
DE_MATRIX_APPROVAL_REQUIRED=true
DE_MATRIX_SECRET_KEY=change-me-in-production
DE_MATRIX_ADMIN_USERNAME=admin
DE_MATRIX_ADMIN_PASSWORD=change-me-admin-password
DE_MATRIX_AUTH_REQUIRED=1
DE_MATRIX_TRUST_REQUEST_ROLE=0
DE_MATRIX_NOTIFICATIONS_ENABLED=1
DE_MATRIX_SMTP_HOST=smtp
DE_MATRIX_SMTP_PORT=1025
DE_MATRIX_SMTP_FROM=de-matrix@localhost

DE_MATRIX_DB_URL=postgresql+psycopg://dematrix:dematrix@postgres:5432/dematrix
# Optional runtime override used by docker-compose for app container:
DE_MATRIX_DB_URL_RUNTIME=postgresql+psycopg://dematrix:dematrix@postgres:5432/dematrix
DE_MATRIX_MONGO_URI=mongodb://mongo:27017
DE_MATRIX_MONGO_DB=de_matrix
DE_MATRIX_APP_PORT=5001
DE_MATRIX_POSTGRES_PORT=15432
DE_MATRIX_MONGO_PORT=27018

# Public reverse proxy/TLS settings
# local: localhost + self-signed
# production: real domain (A-record) + provided cert
DE_MATRIX_DEPLOY_TARGET=local
DE_MATRIX_DOMAIN=localhost
DE_MATRIX_PROXY_HTTP_PORT=80
DE_MATRIX_PROXY_HTTPS_PORT=443
DE_MATRIX_ADMIN_UI_PORT=19000
DE_MATRIX_MAIL_UI_PORT=18025
DE_MATRIX_MAIL_SMTP_PORT=11025
DE_MATRIX_TLS_MODE=selfsigned
DE_MATRIX_TLS_SELF_SIGNED_DAYS=365

# Basic proxy hardening knobs
DE_MATRIX_PROXY_MAX_BODY_SIZE=16m
DE_MATRIX_PROXY_RATE_LIMIT_RPS=20r/s
DE_MATRIX_PROXY_RATE_LIMIT_BURST=40
DE_MATRIX_PROXY_CONN_LIMIT_PER_IP=30
# comma-separated IP/CIDR lists (optional)
DE_MATRIX_PROXY_IP_WHITELIST=127.0.0.1/32
DE_MATRIX_PROXY_IP_BLACKLIST=
DE_MATRIX_FAIL2BAN_BANTIME=2h
DE_MATRIX_FAIL2BAN_FINDTIME=10m
DE_MATRIX_FAIL2BAN_MAXRETRY=30
DE_MATRIX_LOGROTATE_INTERVAL=daily
DE_MATRIX_LOGROTATE_COPIES=14

DE_MATRIX_AUTHOR_NAME=Dmitry Solonnikov
DE_MATRIX_AUTHOR_TELEGRAM=https://t.me/Dmitry_as_SoloD
DE_MATRIX_REPO_URL=https://github.com/SolonnikovDV/de_matrix.git
