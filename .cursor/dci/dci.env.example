# DCI vector store (pgvector container on port 5433)
DCI_VECTOR_HOST=localhost
DCI_VECTOR_PORT=5433
DCI_VECTOR_DB=dci_vectors
DCI_VECTOR_USER=dci
DCI_VECTOR_PASSWORD=dci_local

# Project scope — auto from git root folder name if unset
# DCI_PROJECT_ID=gp_dq
# Legacy alias: DCI_DIALOG_ID (same value as DCI_PROJECT_ID)
# Optional multi-project scan root (subdirs with .cursor/context/project_catalog.md)
# DCI_PROJECTS_ROOT=/Users/me/PycharmProjects
# Optional explicit registry: .cursor/dci/projects.registry (project_id|/path per line)

# Dialog window scope — auto from .dialog_window_lock if unset
# DCI_DIALOG_WINDOW_ID=DW-001

# Optional: OpenAI embeddings (if unset — local TEI, then hash fallback)
# OPENAI_API_KEY=sk-...
# DCI_EMBEDDING_MODEL=text-embedding-3-small

# Local embeddings server (.cursor/tools/dci/lib/dci_embed_server.py, started by: bash .cursor/tools/dci/bin/dci-vector.sh up)
DCI_EMBED_URL=http://localhost:18081/embed
DCI_EMBED_MODEL=intfloat/multilingual-e5-small
